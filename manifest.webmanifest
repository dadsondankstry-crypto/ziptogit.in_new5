{
  "id": "./",
  "name": "Files Explorer v4.4",
  "short_name": "Files Explorer",
  "description": "Explorador de arquivos com editor de texto e código, para uso no celular.",
  "lang": "pt-BR",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#101729",
  "theme_color": "#101729",
